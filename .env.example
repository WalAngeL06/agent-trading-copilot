# Owner-local OKX TR API credentials. Provision READ permission only.
# Copy to .env in the auth worktree; never commit or share the filled file.
# All three fields are required. Blank/partial credentials yield AUTH_MISSING.
# Literal KEY=VALUE syntax; quote values containing #. No shell interpolation.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
