# Optional read-only OKX account credentials; public market data needs no key.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional Telegram. For phones, use an HTTPS WebApp URL.
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=http://localhost:5173

VITE_BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173

# Access control. Required once WEBAPP_URL or ALLOWED_ORIGINS is a public address:
# the backend refuses to start an unprotected public API. Set either or both.
# API_ACCESS_TOKEN: browser access key, at least 24 characters. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# TELEGRAM_ALLOWED_USER_IDS: comma-separated Telegram user IDs allowed to use the
#   bot and the Mini App. Send /start to the bot to see your ID.
API_ACCESS_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
