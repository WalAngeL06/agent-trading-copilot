# Optional read-only OKX TR account access. Public market data needs no key.
OKX_API_KEY=your_read_only_okx_api_key
OKX_SECRET_KEY=your_read_only_okx_secret
OKX_PASSPHRASE=your_read_only_okx_passphrase

# Optional Telegram launcher. Use the public HTTPS frontend URL.
TELEGRAM_BOT_TOKEN=your_botfather_token
WEBAPP_URL=https://your-frontend-url.example

# Browser API target and the matching public frontend CORS origin.
VITE_BACKEND_URL=https://your-backend-url.example
ALLOWED_ORIGINS=https://your-frontend-url.example
